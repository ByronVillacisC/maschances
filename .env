# ==== SERVIDOR ====
NODE_ENV=production
API_URL=https://api.pluschances.com
FRONTEND_URL=https://pluschances.com
APP_PORT=4000

# ==== BACKEND CONNECTION ====
BACKEND_URL=http://localhost:4000

# ==== FRONTEND PUBLIC ====
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# ==== BASE DE DATOS ====
DATABASE_URL=postgresql://pluschances_user:SECURE_PASSWORD@postgres:5432/pluschances?schema=public

# ==== REDIS (Caché + Bull Queue + Rate Limit) ====
REDIS_URL=redis://redis:6379

# ==== JWT ====
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX
JWT_REFRESH_SECRET=REPLACE_WITH_64_CHAR_HEX
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ==== EMAIL ====
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_REPLACE_WITH_RESEND_API_KEY
EMAIL_FROM=noreply@pluschances.com

# ==== ALMACENAMIENTO ====
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_BUCKET=pluschances-media
S3_ACCESS_KEY=REPLACE
S3_SECRET_KEY=REPLACE
S3_REGION=auto
S3_PRIVATE_BUCKET=pluschances-private

# ==== ARCHIVOS ====
MAX_IMAGE_SIZE_MB=5
MAX_VIDEO_SIZE_MB=50
ALLOWED_IMAGE_TYPES=image/jpeg,image/png
ALLOWED_VIDEO_TYPES=video/mp4

# ==== CORS ====
CORS_ORIGINS=https://pluschances.com,https://www.pluschances.com


# ==== FEATURES ====
PAYMENT_ENABLED=false
WHATSAPP_ENABLED=false

# ==== MONITOREO ====
SENTRY_DSN=https://REPLACE@sentry.io/PROJECT_ID